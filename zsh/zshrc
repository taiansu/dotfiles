# typing ... expands to ../.., .... to ../../.., etc.
rationalise-dot() {
  if [[ $LBUFFER = *.. ]]; then
    LBUFFER+=/..
  else
    LBUFFER+=.
  fi
}
zle -N rationalise-dot
bindkey . rationalise-dot
bindkey -M isearch . self-insert # history search fix

function precmd() {
    # Clear the terminal title before running any command.
    # This is a somewhat hacky workaround to Neovim not refreshing the title
    # after it exits.
    echo -ne "\e]1;${PWD##*/}\a"
}

# herdr clear screen, keep scrollback (Fish-style push)
scrollback-push-clear() {
  printf '\n%.0s' {1..$LINES}
  printf '\e[H'
  zle reset-prompt
}
zle -N scrollback-push-clear
bindkey '\e[1;9H' scrollback-push-clear

