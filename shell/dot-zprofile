export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin

export LANG=en_US.UTF-8

export BAT_THEME=DarkNeon

export HOMEBREW_PATH=$homebrew_prefix[$CPUTYPE]
[[ -d $HOMEBREW_PATH ]] && eval "$($HOMEBREW_PATH/bin/brew shellenv)"

# Rust
if [[ -r "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

if (( $+commands[rustc] )); then
  export RUST_SRC_PATH="$(rustc --print sysroot)/lib/rustlib/src/rust/src"
fi

# Idris 2
export IDRIS2_PATH=$HOME/.idris2
if [[ -d $IDRIS2_PATH ]]; then
  export LD_LIBRARY_PATH=$IDRIS2_PATH/lib
  export PATH=$PATH:$IDRIS2_PATH/bin
fi

# PostgresQL
() {
  local postgres=(/opt/homebrew/opt/postgresql@*/bin(Non))
  [[ -n $postgres[1] ]] && export PATH="$postgres[1]:$PATH"
}

path_prepend_if_dir() {
  local dir=$1
  [[ -d $dir ]] || return 0

  path=("$dir" "${(@)path:#$dir}")
}

# source google-cloud-sdk
export GOOGLE_CLOUD_SDK_PATH=$HOMEBREW_PATH/Caskroom/google-cloud-sdk/latest/google-cloud-sdk
path_prepend_if_dir $GOOGLE_CLOUD_SDK_PATH

# Lean 4
export LEAN4_PATH=$HOME/.elan/bin
path_prepend_if_dir $LEAN4_PATH

# dotnet tools
export DOTNET_TOOLS_PATH=$HOME/.dotnet/tools
path_prepend_if_dir $DOTNET_TOOLS_PATH

# Haskell
export HASKELL_INSTALL_PATH=$HOME/.ghcup/bin
path_prepend_if_dir $HASKELL_INSTALL_PATH

# macos-trash
path_prepend_if_dir /opt/homebrew/opt/macos-trash/bin

# Obsidian CLI
path_prepend_if_dir /Applications/Obsidian.app/Contents/MacOS

# bun
path_prepend_if_dir "$HOME/.cache/.bun/bin"

# ANDROID
# export ANDROID_HOME=$brew_prefix[$CPUTYPE]/share/android-sdk
# path_prepend_if_dir $ANDROID_HOME

