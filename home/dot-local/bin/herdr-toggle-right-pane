#!/bin/bash
set -euo pipefail

pane_id=${1:-${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}}
if [[ -z "$pane_id" ]]; then
  printf 'herdr-toggle-right-pane: no active pane ID\n' >&2
  exit 1
fi

neighbor() {
  herdr pane neighbor --pane "$pane_id" --direction "$1" \
    | jq -er '.result.neighbor.neighbor_pane_id // .result.neighbor.pane_id'
}

right_pane_id=$(neighbor right)

if [[ "$right_pane_id" != "$pane_id" ]]; then
  exec herdr pane close "$right_pane_id"
fi

# No right neighbor: we are the right pane if something sits to our left.
left_pane_id=$(neighbor left)

if [[ "$left_pane_id" != "$pane_id" ]]; then
  exec herdr pane close "$pane_id"
fi

exec herdr pane split --pane "$pane_id" --direction right --focus
