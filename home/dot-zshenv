#!/usr/bin/env zsh
# vim:syntax=zsh
# vim:filetype=zsh

typeset -gA homebrew_prefix=(
  x86_64 /usr/local
  arm64 /opt/homebrew
)

if [[ -f ~/.config/dotfiles/credential ]]; then
  source ~/.config/dotfiles/credential
fi

skip_global_compinit=1

# http://disq.us/p/f55b78
setopt noglobalrcs

# Raise the soft file limit only when needed, without changing the hard limit.
() {
  local soft_limit hard_limit target=4096
  soft_limit=$(ulimit -S -n) || return
  if [[ $soft_limit == unlimited ]] || (( soft_limit >= target )); then
    return 0
  fi
  hard_limit=$(ulimit -H -n) || return
  if [[ $hard_limit != unlimited ]] && (( hard_limit < target )); then
    target=$hard_limit
  fi
  if (( target > soft_limit )); then
    ulimit -S -n "$target"
  fi
}

export SYSTEM=$(uname -s)

# basedir defaults, in case they're not already set up.
# http://standards.freedesktop.org/basedir-spec/basedir-spec-latest.html
if [[ -z $XDG_DATA_HOME ]]; then
  export XDG_DATA_HOME=$HOME/.local/share
fi

if [[ -z $XDG_CONFIG_HOME ]]; then
  export XDG_CONFIG_HOME=$HOME/.config
fi

if [[ -z $XDG_CACHE_HOME ]]; then
  export XDG_CACHE_HOME=$HOME/.cache
fi

if [[ -z $XDG_DATA_DIRS ]]; then
  export XDG_DATA_DIRS=/usr/local/share:/usr/share
fi

if [[ -z $XDG_CONFIG_DIRS ]]; then
  export XDG_CONFIG_DIRS=/etc/xdg
fi

# ANSIBLE
export ANSIBLE_NOCOWS=1

# Enable Erlang history by default without replacing explicit startup flags.
if (( ! ${+ERL_AFLAGS} )); then
  export ERL_AFLAGS="-kernel shell_history enabled"
fi

# Locale: keep inherited preferences; use UTF-8 when LANG is unset or empty.
export LANG=${LANG:-en_US.UTF-8}

# KERL
export KERL_BUILD_DOCS=yes
export KERL_INSTALL_MANPAGES=no

# Homebrew
export HOMEBREW_NO_ANALYTICS=1

# Go
# GOROOT 不手動設：由安裝位置決定（mise 為 ~/.local/share/mise/installs/go/<版本>）。
# 這裡只把「資料」移出家目錄頂層——模組快取與 go install 產物。
if (( ! ${+GOPATH} )); then
  export GOPATH=$XDG_DATA_HOME/go
fi
if (( ! ${+GOBIN} )); then
  export GOBIN=$HOME/.local/bin
fi

# Agents
export SKILL_AGENTS="codex claude-code gemini-cli grok github-copilot opencode zed"
