function precmd() {
    if [[ ${DOTFILES_HIDE_PATH:-0} == 1 ]]; then
        printf '\e]0;Recording\a'
    else
        # Restore the tab title after programs such as Neovim change it.
        echo -ne "\e]1;${PWD##*/}\a"
    fi
}

