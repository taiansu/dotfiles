# Functions

function mkcd() {
  mkdir "$1" && cd "$1"
}

# append to pbcopy
pba() {
  local tmp status

  tmp="$(mktemp "${TMPDIR:-/tmp}/pbappend.XXXXXX")" || return 1

  pbpaste >| "$tmp" || {
    rm -f -- "$tmp"
    return 1
  }

  # 原剪貼簿非空時，先加入換行
  [[ -s "$tmp" ]] && printf '\n' >> "$tmp"
  printf '%s' "$*" >> "$tmp"

  pbcopy < "$tmp"
  status=$?

  rm -f -- "$tmp"
  return "$status"
}

# Reuse a completion cache, or safely generate it with the supplied argv.
_dotfiles_source_completion_cache() {
  local completion=$1 tmp
  shift

  if [[ ! -s $completion ]]; then
    (( $+commands[$1] )) || return 0
    mkdir -p -- "${completion:h}" || return 0
    tmp=$(mktemp "${completion}.XXXXXX") || return 0

    if "$@" >| "$tmp" && [[ -s $tmp ]]; then
      mv -f -- "$tmp" "$completion"
    fi
    rm -f -- "$tmp"
  fi

  [[ -r $completion && -s $completion ]] || return 0
  source "$completion"
}

