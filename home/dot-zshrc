  fzf_directory_preview='eza --tree --color=always {} | head -200'
  export FZF_ALT_C_OPTS="--preview '$fzf_directory_preview'"
fi

# Keep the existing file/directory behavior for each available-tool combination.
fzf_path_preview=''
if [[ -n $fzf_directory_preview && -n $fzf_file_preview ]]; then
  fzf_path_preview="if [ -d {} ]; then $fzf_directory_preview; else $fzf_file_preview; fi"
elif [[ -n $fzf_directory_preview ]]; then
  fzf_path_preview="if [ -d {} ]; then $fzf_directory_preview; fi"
elif [[ -n $fzf_file_preview ]]; then
  fzf_path_preview="if [ -f {} ]; then $fzf_file_preview; fi"
fi
# Advanced customization of fzf options via _fzf_comprun function
# - The first argument to the function is the name of the command.
# - You should make sure to pass the rest of the arguments to fzf.
_fzf_comprun() {
  local command=$1 preview=''
  local -a preview_args=()
  shift

  case "$command" in
    cd)           preview=$fzf_directory_preview ;;
    export|unset) preview="eval 'echo ${}'" ;;
    ssh)          preview='dig {}' ;;
    *)            preview=$fzf_path_preview ;;
  esac

  [[ -n $preview ]] && preview_args=(--preview "$preview")
  fzf "${preview_args[@]}" "$@"
}

