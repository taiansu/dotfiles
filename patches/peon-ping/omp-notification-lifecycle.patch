+interface PeonEventDetails {
+  notificationType?: string
+  toolName?: string
+  error?: string
+}
+
+const RESERVED_ASK_LABELS: Record<string, true> = {
+  "Other (type your own)": true,
+  "Chat about this": true,
+  "Next →": true,
+}
+
+function isValidAskArgs(args: unknown): boolean {
+  if (
+    args === null
+    || typeof args !== "object"
+    || Array.isArray(args)
+    || !("questions" in args)
+    || !Array.isArray(args.questions)
+    || args.questions.length === 0
+  ) {
+    return false
+  }
+
+  return args.questions.every(question => {
+    if (
+      question === null
+      || typeof question !== "object"
+      || Array.isArray(question)
+      || !("id" in question)
+      || typeof question.id !== "string"
+      || !("question" in question)
+      || typeof question.question !== "string"
+      || !("options" in question)
+      || !Array.isArray(question.options)
+      || ("header" in question && typeof question.header !== "string")
+      || ("multi" in question && typeof question.multi !== "boolean")
+      || (
+        "recommended" in question
+        && (typeof question.recommended !== "number" || !Number.isFinite(question.recommended))
+      )
+    ) {
+      return false
+    }
+
+    return question.options.every(option =>
+      option !== null
+      && typeof option === "object"
+      && !Array.isArray(option)
+      && "label" in option
+      && typeof option.label === "string"
+      && RESERVED_ASK_LABELS[option.label] !== true
+      && (!("description" in option) || typeof option.description === "string")
+      && (!("preview" in option) || typeof option.preview === "string")
+    )
+  })
+}
